# Public site URL (used for sitemap.xml, robots.txt, metadata base URL).
# Set to your real domain once deployed, e.g. https://www.klass-sarl.com
NEXT_PUBLIC_SITE_URL=https://klass-sarl.example.com

# ---------------------------------------------------------------------------
# Contact form email — required for form submissions to ACTUALLY send.
#
# Copy this file to `.env.local` and fill in your SMTP credentials.
# Any SMTP provider works (Gmail, Yahoo, Zoho, Hostinger, Infomaniak, etc.).
# With no SMTP configured, the form gracefully falls back to opening the
# visitor's own email app (mailto) addressed to Klasssarl@yahoo.com.
# ---------------------------------------------------------------------------
SMTP_HOST=your-smtp-host.com
SMTP_PORT=587            # 465 for SSL, 587 for STARTTLS
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Where the contact form messages are delivered (defaults to Klasssarl@yahoo.com).
CONTACT_TO=Klasssarl@yahoo.com
# "From" address used when sending (optional; defaults to SMTP_USER).
FROM_EMAIL=Klasssarl@yahoo.com
